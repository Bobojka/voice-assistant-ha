#!/usr/bin/env bash
# Runs the tests. The integration lives in the repository root (HACS
# content_in_root), so it is staged as custom_components/voice_assistant_ha.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
stage="$(mktemp -d)"
trap 'rm -rf "$stage"' EXIT
mkdir -p "$stage/custom_components/voice_assistant_ha"
touch "$stage/custom_components/__init__.py"
cp "$root"/*.py "$root"/*.json "$stage/custom_components/voice_assistant_ha/"
cp -r "$root/translations" "$stage/custom_components/voice_assistant_ha/"
cp -r "$root/tests" "$stage/tests"
cat > "$stage/pytest.ini" <<'INI'
[pytest]
asyncio_mode = auto
testpaths = tests
INI
cd "$stage"
python -m pytest -q -p no:cacheprovider "$@"
